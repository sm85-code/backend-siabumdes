# --- Core ---
APP_TITLE=SIABUMDES API
# Dokumentasi API publik (/docs, /redoc, /openapi.json). Default mati (404);
# set true hanya untuk lokal/dev.
ENABLE_API_DOCS=false
# Postgres SIABUMDES (bisa juga POSTGRES_URL). sslmode/channel_binding dibuang
# otomatis; SSL diatur lewat POSTGRES_SSL.
DATABASE_URL=postgresql://user:password@host:5432/siabumdes?sslmode=require
POSTGRES_SSL=true

# --- Auth (JWT cookie) ---
JWT_SECRET=replace-with-long-random-string
# Optional: secret khusus tenant `bumdes`. Kosong = fallback ke JWT_SECRET.
# Agar sesi yang diterbitkan sm85-arch tetap valid, samakan nilainya dengan
# yang dipakai sm85-arch saat ini.
JWT_SECRET_BUMDES=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168
# Cookie name is fixed in code (shared/config.py::JWT_COOKIE_NAME = "bumdes_token"),
# not configurable here -- it's not a secret, just needs to match between set/read.

# --- CORS / cookie (frontend static site + backend web service beda host) ---
CORS_ORIGINS=https://siabumdes.ampelkuning.com,http://localhost:3000
CORS_ORIGIN_REGEX=
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_PATH=/

# --- Google Drive (upload bukti transaksi, logo, foto profil, laporan) ---
# Service account (disarankan):
GDRIVE_FOLDER_ID=
GDRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# atau path file kredensial service account:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
# Folder opsional untuk logo organisasi dan foto profil pengguna:
GDRIVE_FOLDER_ID_LOGO=
GDRIVE_FOLDER_ID_PHOTO=
# Google OAuth (alternatif service account). Refresh token hanya lewat env
# platform — /api/admin/gdrive/oauth-callback tidak pernah mengembalikan
# refresh_token di JSON (butuh sesi admin + signed state).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Kop surat / tanda tangan export PDF & Excel ---
# (fallback lama ORG_NAME, ORG_LEGAL_NAME, ORG_ADDRESS, ORG_VILLAGE, ORG_DISTRICT,
#  ORG_REGENCY, ORG_PROVINCE, ORG_PHONE, ORG_EMAIL masih dibaca bila REPORT_* kosong)
REPORT_ORG_NAME=BUMDes Contoh
REPORT_ORG_LEGAL_NAME=Badan Usaha Milik Desa Contoh
REPORT_ORG_ADDRESS=Jl. Desa No. 1
REPORT_ORG_VILLAGE=Desa Contoh
REPORT_ORG_DISTRICT=Kecamatan Contoh
REPORT_ORG_REGENCY=Kabupaten Contoh
REPORT_ORG_PROVINCE=Jawa Barat
REPORT_ORG_PHONE=
REPORT_ORG_EMAIL=
REPORT_ORG_TAGLINE=Laporan Keuangan
REPORT_ORG_LOGO_URL=
REPORT_PRIMARY_COLOR=1F4E79
REPORT_SIGN_LEFT_TITLE=Direktur / Ketua
REPORT_SIGN_LEFT_NAME=
REPORT_SIGN_MID_TITLE=Bendahara
REPORT_SIGN_MID_NAME=
REPORT_SIGN_RIGHT_TITLE=Mengetahui
REPORT_SIGN_RIGHT_NAME=
